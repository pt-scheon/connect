# Copy to .env.local and fill in. Nothing here is needed to try the app locally with sample people.

# Where the app is reachable. Must match the redirect URL in your LinkedIn app:
#   <APP_URL>/api/auth/google/callback and <APP_URL>/api/auth/linkedin/callback
APP_URL=http://localhost:3000

# Long random string. Required in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
# A student who signs in with a Google account on COLLEGE_EMAIL_DOMAIN is verified straight away.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn developer app with the "Sign In with LinkedIn using OpenID Connect" product added.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Only addresses on this domain can verify as students, e.g. college.ac.in
COLLEGE_EMAIL_DOMAIN=

# LinkedIn emails that become admins on sign-in, comma separated.
ADMIN_EMAILS=

# Email for verification codes and inbox alerts. Set ONE of these. Without either, codes only work in
# development (printed in the server log), and in production students verify by signing in with a
# Google account on COLLEGE_EMAIL_DOMAIN.
# Easiest: a Gmail app password (myaccount.google.com/apppasswords), written as
#   SMTP_URL=smtps://yourname%40gmail.com:the16letterpassword@smtp.gmail.com:465
SMTP_URL=
# Or resend.com, which needs a domain you own.
RESEND_API_KEY=
MAIL_FROM=Connect <yourname@gmail.com>

# Shown on the privacy page as the address for questions. Optional.
CONTACT_EMAIL=

# Gemini API key from Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=
# Used when the main model is overloaded. Comma separated. Defaults to gemini-3.5-flash.
GEMINI_FALLBACK_MODEL=

# Optional. Defaults to ./data/connect.db
DATABASE_PATH=
